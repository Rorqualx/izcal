+/// Clock for [`new_predictable_platform`]. Both methods may be called from
+/// any thread that V8 uses, so implementations must be `Send + Sync`, and
+/// they must not call into V8.
+pub trait PlatformClock: Send + Sync {
+  /// `Platform::MonotonicallyIncreasingTime`, in seconds. Must not decrease.
+  /// Also drives delayed foreground and worker tasks, GC heuristics that read
+  /// the platform clock, and `performance.now()`-like embedder clocks.
+  fn monotonically_increasing_time(&self) -> f64;
+
+  /// `Platform::CurrentClockTimeMillis`, in milliseconds since the Unix
+  /// epoch. This is what `Date.now()` and `new Date()` read. Defaults to
+  /// `monotonically_increasing_time() * 1000`, as in d8's predictable mode.
+  fn current_clock_time_millis(&self) -> f64 {
+    self.monotonically_increasing_time() * 1000.0
+  }
+}
+
+/// A closure returning seconds is a [`PlatformClock`] whose wall clock is
+/// derived from it (`Date.now() == f() * 1000`).
+impl<F: Fn() -> f64 + Send + Sync> PlatformClock for F {
+  fn monotonically_increasing_time(&self) -> f64 {
+    self()
+  }
+}
+
+/// How [`new_predictable_platform`] handles tasks that V8 posts to worker
+/// threads (`CallOnWorkerThread`, job workers, delayed worker tasks).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum WorkerTaskMode {
+  /// Run each task synchronously on the thread that posts it. Delayed worker
+  /// tasks are still queued (see `Queued`). Simple, but V8 does not expect a
+  /// post to run the task re-entrantly; prefer `Queued` together with
+  /// `--single-threaded`, which keeps V8 from posting most worker tasks.
+  Inline,
+  /// Queue tasks until the embedder calls
+  /// [`Platform::run_worker_tasks`] (d8's behaviour, except that delayed
+  /// worker tasks run once the platform clock reaches their due time instead
+  /// of being dropped).
+  Queued,
+}
+
+type BoxedClock = Box<dyn PlatformClock>;
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn v8__Platform__PredictablePlatform__BASE__MonotonicallyIncreasingTime(
+  context: *mut std::ffi::c_void,
+) -> f64 {
+  let clock = unsafe { &*(context as *const BoxedClock) };
+  clock.monotonically_increasing_time()
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn v8__Platform__PredictablePlatform__BASE__CurrentClockTimeMillis(
+  context: *mut std::ffi::c_void,
+) -> f64 {
+  let clock = unsafe { &*(context as *const BoxedClock) };
+  clock.current_clock_time_millis()
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn v8__Platform__PredictablePlatform__BASE__DROP(
+  context: *mut std::ffi::c_void,
+) {
+  if !context.is_null() {
+    unsafe {
+      let _ = Box::from_raw(context as *mut BoxedClock);
+    }
+  }
+}
