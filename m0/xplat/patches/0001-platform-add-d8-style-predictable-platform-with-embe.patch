+/// Creates a d8-style predictable platform (V8's
+/// `src/d8/d8-platforms.cc` `PredictablePlatform`) for deterministic
+/// simulation:
+///
+/// - Worker-thread tasks never run on V8-owned threads: see
+///   [`WorkerTaskMode`]. No worker threads are created.
+///   `NumberOfWorkerThreads()` reports `reported_worker_threads`.
+/// - `MonotonicallyIncreasingTime` and `CurrentClockTimeMillis` (`Date.now`)
+///   come from `clock`. With `None`, d8's synthetic clock is used: a counter
+///   that advances by 10 µs on every read. The foreground task runners use
+///   the same clock for delayed tasks, so they only become runnable when the
+///   clock advances.
+/// - Foreground tasks are queued as in the default platform; drain them with
+///   [`Platform::pump_message_loop`].
+/// - Idle tasks are disabled.
+///
+/// Use it with [`set_predictable_flags`](crate::V8::set_predictable_flags)
+/// (`--predictable --single-threaded --random-seed=N`), set before
+/// `V8::initialize`. Only one predictable platform may exist per process.
+#[inline(always)]
+pub fn new_predictable_platform(
+  clock: Option<Box<dyn PlatformClock>>,
+  worker_task_mode: WorkerTaskMode,
+  reported_worker_threads: u32,
+) -> UniqueRef<Platform> {
+  Platform::new_predictable(clock, worker_task_mode, reported_worker_threads)
+}
