+// Rust-side callbacks for PredictablePlatform's clock. `context` is a pointer
+// to the Rust Box<dyn PlatformClock>, or null for d8's synthetic clock.
+extern "C" {
+double v8__Platform__PredictablePlatform__BASE__MonotonicallyIncreasingTime(
+    void* context);
+double v8__Platform__PredictablePlatform__BASE__CurrentClockTimeMillis(
+    void* context);
+void v8__Platform__PredictablePlatform__BASE__DROP(void* context);
+}
+
+// A d8-style predictable platform (cf. v8/src/d8/d8-platforms.cc
+// PredictablePlatform) for deterministic embedders:
+// - Worker-thread tasks (CallOnWorkerThread, PostJob workers) never run on a
+//   V8-owned thread. They are either run inline on the posting thread, or
+//   queued until the embedder drains them with RunWorkerTasks() on a thread
+//   of its choice. Delayed worker tasks are queued with a due time on the
+//   platform clock (d8 drops them).
+// - MonotonicallyIncreasingTime and CurrentClockTimeMillis (Date.now) come
+//   from an embedder callback; without one, d8's synthetic clock is used
+//   (a counter advancing 10us per read). The foreground task runners use the
+//   same clock for delayed tasks.
+// It derives from DefaultPlatform (with no worker threads) because
+// v8::platform::PumpMessageLoop/NotifyIsolateShutdown static_cast to it.
+// Only one PredictablePlatform may exist per process, like V8's platform.
+class PredictablePlatform final : public v8::platform::DefaultPlatform {
+ public:
+  PredictablePlatform(int reported_worker_threads, bool inline_worker_tasks,
+                      void* clock_context)
+      : DefaultPlatform(0, v8::platform::IdleTaskSupport::kDisabled),
+        reported_worker_threads_(reported_worker_threads),
+        inline_worker_tasks_(inline_worker_tasks),
+        clock_context_(clock_context) {
+    instance_.store(this);
+    SetTimeFunctionForTesting(&StaticMonotonicTime);
+  }
+
+  ~PredictablePlatform() override {
+    instance_.store(nullptr);
+    v8__Platform__PredictablePlatform__BASE__DROP(clock_context_);
+  }
+
+  static PredictablePlatform* From(v8::Platform* platform) {
+    PredictablePlatform* p = instance_.load();
+    return p == platform ? p : nullptr;
+  }
+
+  int NumberOfWorkerThreads() override { return reported_worker_threads_; }
+
+  double MonotonicallyIncreasingTime() override {
+    if (clock_context_ == nullptr) {
+      return 1e-5 * synthetic_time_.fetch_add(1, std::memory_order_relaxed);
+    }
+    return v8__Platform__PredictablePlatform__BASE__MonotonicallyIncreasingTime(
+        clock_context_);
+  }
+
+  double CurrentClockTimeMillis() override {
+    if (clock_context_ == nullptr) return MonotonicallyIncreasingTime() * 1e3;
+    return v8__Platform__PredictablePlatform__BASE__CurrentClockTimeMillis(
+        clock_context_);
+  }
+
+  // Runs queued worker tasks (and delayed ones that are due) on the calling
+  // thread until none are runnable. Returns the number of tasks run.
+  size_t RunWorkerTasks() {
+    size_t n = 0;
+    for (;;) {
+      std::unique_ptr<v8::Task> task;
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!delayed_.empty()) {
+          double now = MonotonicallyIncreasingTime();
+          for (auto it = delayed_.begin(); it != delayed_.end();) {
+            if (it->first <= now) {
+              queue_.push_back(std::move(it->second));
+              it = delayed_.erase(it);
+            } else {
+              ++it;
+            }
+          }
+        }
+        if (queue_.empty()) return n;
+        task = std::move(queue_.front());
+        queue_.erase(queue_.begin());
+      }
+      task->Run();
+      n++;
+    }
+  }
+
+  size_t PendingWorkerTasks() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return queue_.size() + delayed_.size();
+  }
+
+ protected:
+  void PostTaskOnWorkerThreadImpl(v8::TaskPriority priority,
+                                  std::unique_ptr<v8::Task> task,
+                                  const v8::SourceLocation& location) override {
+    if (inline_worker_tasks_) {
+      task->Run();
+      return;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    queue_.push_back(std::move(task));
+  }
+
+  void PostDelayedTaskOnWorkerThreadImpl(
+      v8::TaskPriority priority, std::unique_ptr<v8::Task> task,
+      double delay_in_seconds, const v8::SourceLocation& location) override {
+    double due = MonotonicallyIncreasingTime() + delay_in_seconds;
+    std::lock_guard<std::mutex> lock(mutex_);
+    delayed_.emplace_back(due, std::move(task));
+  }
+
+ private:
+  static double StaticMonotonicTime() {
+    return instance_.load()->MonotonicallyIncreasingTime();
+  }
+
+  static inline std::atomic<PredictablePlatform*> instance_{nullptr};
+  const int reported_worker_threads_;
+  const bool inline_worker_tasks_;
+  void* const clock_context_;
+  std::atomic<uint64_t> synthetic_time_{0};
+  std::mutex mutex_;
+  std::vector<std::unique_ptr<v8::Task>> queue_;
+  std::vector<std::pair<double, std::unique_ptr<v8::Task>>> delayed_;
+};
+
+v8::Platform* v8__Platform__NewPredictablePlatform(int reported_worker_threads,
+                                                   bool inline_worker_tasks,
+                                                   void* clock_context) {
+  return std::make_unique<PredictablePlatform>(
+             std::max(reported_worker_threads, 0), inline_worker_tasks,
+             clock_context)
+      .release();
+}
+
+// Returns SIZE_MAX if `platform` is not the PredictablePlatform.
+size_t v8__Platform__PredictablePlatform__RunWorkerTasks(
+    v8::Platform* platform) {
+  PredictablePlatform* p = PredictablePlatform::From(platform);
+  return p ? p->RunWorkerTasks() : SIZE_MAX;
+}
+
+size_t v8__Platform__PredictablePlatform__PendingWorkerTasks(
+    v8::Platform* platform) {
+  PredictablePlatform* p = PredictablePlatform::From(platform);
+  return p ? p->PendingWorkerTasks() : SIZE_MAX;
+}
