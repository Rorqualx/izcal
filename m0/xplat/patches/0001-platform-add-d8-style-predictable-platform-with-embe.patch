+impl Platform {
+  /// See [`new_predictable_platform`].
+  pub fn new_predictable(
+    clock: Option<Box<dyn PlatformClock>>,
+    worker_task_mode: WorkerTaskMode,
+    reported_worker_threads: u32,
+  ) -> UniqueRef<Self> {
+    let context = match clock {
+      Some(clock) => Box::into_raw(Box::new(clock)) as *mut std::ffi::c_void,
+      None => std::ptr::null_mut(),
+    };
+    unsafe {
+      UniqueRef::from_raw(v8__Platform__NewPredictablePlatform(
+        reported_worker_threads.min(i32::MAX as u32) as i32,
+        worker_task_mode == WorkerTaskMode::Inline,
+        context,
+      ))
+    }
+  }
+
+  /// Runs the worker tasks queued by a predictable platform (and delayed
+  /// worker tasks whose due time has been reached) on the calling thread,
+  /// until none is runnable. Returns the number of tasks run, or `None` if
+  /// `platform` was not created by [`new_predictable_platform`].
+  pub fn run_worker_tasks(platform: &SharedRef<Self>) -> Option<usize> {
+    let n = unsafe {
+      v8__Platform__PredictablePlatform__RunWorkerTasks(
+        &**platform as *const Self as *mut _,
+      )
+    };
+    (n != usize::MAX).then_some(n)
+  }
+
+  /// Number of worker tasks a predictable platform holds (queued plus
+  /// delayed), or `None` if `platform` is not a predictable platform.
+  pub fn pending_worker_tasks(platform: &SharedRef<Self>) -> Option<usize> {
+    let n = unsafe {
+      v8__Platform__PredictablePlatform__PendingWorkerTasks(
+        &**platform as *const Self as *mut _,
+      )
+    };
+    (n != usize::MAX).then_some(n)
+  }
+}
