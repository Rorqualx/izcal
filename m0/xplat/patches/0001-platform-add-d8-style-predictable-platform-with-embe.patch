+use std::sync::Arc;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+// Virtual time in microseconds, advanced only by the test.
+static NOW_US: AtomicU64 = AtomicU64::new(1_000_000_000_000);
+
+fn eval(scope: &mut v8::PinScope, src: &str) -> String {
+  let source = v8::String::new(scope, src).unwrap();
+  let script = v8::Script::compile(scope, source, None).unwrap();
+  let result = script.run(scope).unwrap();
+  result.to_rust_string_lossy(scope)
+}
+
+fn run_once(platform: &v8::SharedRef<v8::Platform>) -> String {
+  let isolate = &mut v8::Isolate::new(Default::default());
+  v8::scope!(let scope, isolate);
+  let context = v8::Context::new(scope, Default::default());
+  let scope = &mut v8::ContextScope::new(scope, context);
+  let t0 = eval(scope, "Date.now()");
+  NOW_US.fetch_add(1_500, Ordering::SeqCst);
+  let t1 = eval(scope, "Date.now()");
+  let r = eval(scope, "[Math.random(), Math.random()].join()");
+  while v8::Platform::pump_message_loop(platform, scope, false) {}
+  assert!(v8::Platform::run_worker_tasks(platform).is_some());
+  format!("{t0} {t1} {r}")
+}
+
+#[test]
+fn predictable_platform() {
+  v8::V8::set_predictable_flags(42);
+  let calls = Arc::new(AtomicU64::new(0));
+  let calls2 = calls.clone();
+  let clock = move || {
+    calls2.fetch_add(1, Ordering::Relaxed);
+    NOW_US.load(Ordering::SeqCst) as f64 / 1e6
+  };
+  let platform = v8::new_predictable_platform(
+    Some(Box::new(clock)),
+    v8::WorkerTaskMode::Queued,
+    1,
+  )
+  .make_shared();
+  v8::V8::initialize_platform(platform.clone());
+  v8::V8::initialize();
+
+  NOW_US.store(1_000_000_000_000, Ordering::SeqCst);
+  let a = run_once(&platform);
+  NOW_US.store(1_000_000_000_000, Ordering::SeqCst);
+  let b = run_once(&platform);
+  assert_eq!(a, b);
+  let parts: Vec<&str> = a.split(' ').collect();
+  assert_eq!(parts[0], "1000000000");
+  assert_eq!(parts[1], "1000000001");
+  assert!(calls.load(Ordering::Relaxed) > 0);
+  assert_eq!(v8::Platform::pending_worker_tasks(&platform), Some(0));
+
+  unsafe { v8::V8::dispose() };
+  v8::V8::dispose_platform();
+}
