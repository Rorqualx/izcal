-unsafe fn slice_to_vec<T: Copy>(p: *const T, n: usize) -> Vec<T> {
-  if n == 0 || p.is_null() { Vec::new() } else { unsafe { std::slice::from_raw_parts(p, n).to_vec() } }
-}
-
-unsafe fn str_to_string(p: *const std::ffi::c_char, n: usize) -> String {
-  String::from_utf8_lossy(unsafe { slice_to_vec(p as *const u8, n) }.as_slice()).into_owned()
-}
-
-fn collect_statistics(heap: &Heap, level: DetailLevel) -> HeapStatistics {
-  struct Owned(*mut ffi::HeapStatistics);
-  impl Drop for Owned {
-    fn drop(&mut self) {
-      unsafe { ffi::cppgc__HeapStatistics__DELETE(self.0) }
-    }
-  }
-  let raw = Owned(unsafe { ffi::v8__CppHeap__CollectStatistics(heap as *const Heap as *mut Heap, level as u8) });
-  let s = raw.0 as *const ffi::HeapStatistics;
-  unsafe {
-    let mut t = ffi::Totals::default();
-    ffi::cppgc__HeapStatistics__GetTotals(s, &mut t);
-    let mut space_stats = Vec::with_capacity(t.space_count);
-    for i in 0..t.space_count {
-      let mut sp = std::mem::MaybeUninit::<ffi::Space>::uninit();
-      assert!(ffi::cppgc__HeapStatistics__GetSpace(s, i, sp.as_mut_ptr()));
-      let sp = sp.assume_init();
-      let mut page_stats = Vec::with_capacity(sp.page_count);
-      for j in 0..sp.page_count {
-        let mut pg = std::mem::MaybeUninit::<ffi::Page>::uninit();
-        assert!(ffi::cppgc__HeapStatistics__GetPage(s, i, j, pg.as_mut_ptr()));
-        let pg = pg.assume_init();
-        page_stats.push(PageStatistics {
-          committed_size_bytes: pg.committed_size_bytes,
-          resident_size_bytes: pg.resident_size_bytes,
-          used_size_bytes: pg.used_size_bytes,
-          object_statistics: slice_to_vec(pg.object_statistics, pg.object_statistics_len),
-        });
-      }
-      let mut fl = std::mem::MaybeUninit::<ffi::FreeList>::uninit();
-      assert!(ffi::cppgc__HeapStatistics__GetFreeList(s, i, fl.as_mut_ptr()));
-      let fl = fl.assume_init();
-      space_stats.push(SpaceStatistics {
-        name: str_to_string(sp.name, sp.name_len),
-        committed_size_bytes: sp.committed_size_bytes,
-        resident_size_bytes: sp.resident_size_bytes,
-        used_size_bytes: sp.used_size_bytes,
-        page_stats,
-        free_list_stats: FreeListStatistics {
-          bucket_size: slice_to_vec(fl.bucket_size, fl.bucket_size_len),
-          free_count: slice_to_vec(fl.free_count, fl.free_count_len),
-          free_size: slice_to_vec(fl.free_size, fl.free_size_len),
-        },
-      });
-    }
-    let mut type_names = Vec::with_capacity(t.type_name_count);
-    for i in 0..t.type_name_count {
-      let mut len = 0usize;
-      let p = ffi::cppgc__HeapStatistics__GetTypeName(s, i, &mut len);
-      type_names.push(str_to_string(p, len));
-    }
-    HeapStatistics {
-      committed_size_bytes: t.committed_size_bytes,
-      resident_size_bytes: t.resident_size_bytes,
-      used_size_bytes: t.used_size_bytes,
-      pooled_memory_size_bytes: t.pooled_memory_size_bytes,
-      detail_level: if t.detail_level == 0 { DetailLevel::Brief } else { DetailLevel::Detailed },
-      space_stats,
-      type_names,
-    }
-  }
-}
-
