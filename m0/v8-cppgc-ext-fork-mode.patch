-/// Equivalent of `CPPGC_USING_PRE_FINALIZER(Class, PreFinalizer)`.
-///
-/// `pre_finalize` runs once, on the heap's thread, in the atomic pause of the
-/// GC that finds the object dead, **before any destructor (`Drop`) of that
-/// cycle runs**. It may read the whole object graph, dead or alive (dead
-/// objects are not swept yet); use `broker` to tell which is which. It must
-/// not allocate cppgc objects (cppgc `CHECK`s that unless built with
-/// `CPPGC_ALLOW_ALLOCATIONS_IN_PREFINALIZERS`) and must not resurrect the
-/// object by storing references to it. A panic aborts the process.
-pub trait PreFinalizer: GarbageCollected {
-  fn pre_finalize(&self, broker: &LivenessBroker);
-}
-
-/// Mirror of rusty_v8's private `RustObjConcrete<T>` (src/cppgc.rs):
-/// `{ head: RustObj, dynamic: *mut dyn GarbageCollected, value: T }`, with
-/// `RustObj` = one vtable pointer (size 8, align 8, checked against
-/// rusty_v8's bindgen layout test by build.rs). The offset is re-verified at
-/// every registration, so a layout change in rusty_v8 panics instead of
-/// corrupting memory. The upstream patch uses `RustObjConcrete` directly.
-#[repr(C)]
-struct RustObjConcreteMirror<T> {
-  head: RustObjHead,
-  dynamic: *mut dyn GarbageCollected,
-  value: T,
-}
-#[repr(C, align(8))]
-struct RustObjHead([u8; 8]);
-
-unsafe extern "C" fn invoke_pre_finalizer<T: PreFinalizer>(broker: &LivenessBroker, object: *mut c_void) -> bool {
-  unsafe {
-    if broker.is_heap_object_alive_raw(object) {
-      return false; // still alive: keep the registration
-    }
-    let concrete = object as *const RustObjConcreteMirror<T>;
-    (*std::ptr::addr_of!((*concrete).value)).pre_finalize(broker);
-  }
-  true
-}
-
-/// Registers `T::pre_finalize` for an object allocated with
-/// [`v8::cppgc::make_garbage_collected`]. This is what the
-/// `CPPGC_USING_PRE_FINALIZER` member does in a C++ constructor.
-///
-/// # Safety
-/// - `ptr` must point to a live object of type `T` on a heap owned by the
-///   current thread;
-/// - register at most once per object (cppgc DCHECKs duplicates);
-/// - not from inside a prefinalizer.
-pub unsafe fn register_prefinalizer<T: PreFinalizer + 'static>(ptr: &UnsafePtr<T>) {
-  let obj = rust_obj_ptr(ptr);
-  let expect = unsafe { ptr.as_ref() } as *const T as usize;
-  let got = unsafe { std::ptr::addr_of!((*(obj as *const RustObjConcreteMirror<T>)).value) } as usize;
-  assert_eq!(got, expect, "rusty_v8 RustObjConcrete layout changed; prefinalizer support must be updated");
-  unsafe { ffi::cppgc__RustObj__RegisterPrefinalizer(obj, invoke_pre_finalizer::<T>) };
-}
-
-/// [`v8::cppgc::make_garbage_collected`] plus [`register_prefinalizer`].
-///
-/// # Safety
-/// Same contract as [`v8::cppgc::make_garbage_collected`] (keep the returned
-/// pointer on the stack or move it into a traced/persistent handle), and the
-/// heap must be owned by the current thread.
-pub unsafe fn make_garbage_collected_with_prefinalizer<T: PreFinalizer + 'static>(heap: &Heap, obj: T) -> UnsafePtr<T> {
-  let ptr = unsafe { v8::cppgc::make_garbage_collected(heap, obj) };
-  unsafe { register_prefinalizer(&ptr) };
-  ptr
-}
-
-/// A per-object weak callback, the Rust form of
