-  /// Same as [`Self::is_heap_object_alive`] for a raw object pointer as
-  /// returned by `GetRustObj::get_rust_obj()`.
-  ///
-  /// # Safety
-  /// `object` must be null or point to a live-or-unswept cppgc object.
-  pub unsafe fn is_heap_object_alive_raw(&self, object: *const c_void) -> bool {
-    unsafe { ffi::cppgc__LivenessBroker__IsHeapObjectAlive(self, object) }
-  }
-}
