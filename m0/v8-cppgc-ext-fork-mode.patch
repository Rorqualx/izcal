-//! Safe Rust bindings for the cppgc (Oilpan) APIs that rusty_v8 152.2.0
-//! (V8 15.2.124.1) does not expose.
-//!
-//! The bindings go through a small C++ shim (`src/binding.cc`) that `build.rs`
-//! compiles against rusty_v8's own V8 headers and Chromium libc++ with the
-//! prebuilt library's ABI-relevant defines. Only `extern "C"` functions and
-//! opaque pointers cross the boundary; no mangled C++ names are linked and no
-//! C++ standard-library layout is mirrored in Rust.
-//!
-//! | C++ | Rust |
-//! |---|---|
-//! | `v8::CppHeap::GetHeapHandle` | [`HeapHandle::new`], [`CppHeapExt::heap_handle`] |
-//! | `cppgc::subtle::NoGarbageCollectionScope` | [`NoGarbageCollectionScope`] |
-//! | `cppgc::subtle::DisallowGarbageCollectionScope` | [`DisallowGarbageCollectionScope`] |
-//! | `cppgc::subtle::HeapState` | [`HeapState`] |
-//! | `v8::CppHeap::CollectStatistics` | [`CppHeapExt::collect_statistics`] → [`HeapStatistics`] |
-//! | `CPPGC_USING_PRE_FINALIZER` | [`PreFinalizer`], [`make_garbage_collected_with_prefinalizer`] |
-//! | `cppgc::LivenessBroker` | [`LivenessBroker`] |
-//! | `cppgc::Visitor::RegisterWeakCallback(Method)` | [`VisitorExt`] |
-//! | `v8::Isolate::RequestGarbageCollectionForTesting(type, stack_state)` | [`IsolateExt::request_garbage_collection_for_testing_with_stack_state`] |
-//! | `cppgc::testing::*` | [`testing`] |
-//! | `cppgc::subtle::HeapConsistency` | [`heap_consistency`] |
-//!
-//! # Threading
-//!
-//! cppgc heaps are single-threaded: scopes, state queries, statistics and the
-//! testing API must be used on the thread that owns the heap (for the
-//! isolate's CppHeap: the thread that currently owns the isolate). All handle
-//! and guard types here are `!Send + !Sync`, so a scope entered on one thread
-//! cannot be left on another.
-//!
-//! # No compactable spaces
-//!
-//! cppgc only ever moves objects that live in *custom spaces declared
-//! compactable*. rusty_v8 creates every `CppHeap` with no custom spaces
-//! (`binding.cc`: `v8::CppHeapCreateParams params{{}}`) and the isolate's own
-//! CppHeap has none either, so cppgc never relocates rusty_v8 objects and raw
-//! pointers to them stay valid until they are swept. Code that relies on this
-//! (e.g. worker threads reading through raw pointers inside a
-//! [`NoGarbageCollectionScope`]) can check it at runtime with
-//! [`CppHeapExt::assert_no_compactable_spaces`]. This crate deliberately does
-//! not expose custom spaces.
-//!
-//! # Example
-//!
-//! ```no_run
-//! use v8_cppgc_ext::*;
-//! fn worker_phase(heap: &v8::cppgc::Heap) {
-//!   let h = heap.heap_handle();
-//!   let _no_gc = NoGarbageCollectionScope::new(h);
-//!   let _fail_fast = DisallowGarbageCollectionScope::new(h);
-//!   assert!(!DisallowGarbageCollectionScope::is_garbage_collection_allowed(h));
-//!   // ... hand raw pointers to worker threads and block until they finish ...
-//! }
-//! ```
-//!
-//! Guards cannot leave their thread:
-//!
-//! ```compile_fail
-//! fn assert_send<T: Send>() {}
-//! assert_send::<v8_cppgc_ext::NoGarbageCollectionScope<'static>>();
-//! ```
-//!
-//! ```compile_fail
-//! fn assert_send<T: Send>() {}
-//! assert_send::<v8_cppgc_ext::HeapHandle<'static>>();
-//! ```
-//!
-//! and cannot outlive their heap:
-//!
-//! ```compile_fail
-//! use v8_cppgc_ext::*;
-//! fn f(platform: v8::SharedRef<v8::Platform>) {
-//!   let scope;
-//!   {
-//!     let heap = v8::cppgc::Heap::create(platform, Default::default());
-//!     scope = NoGarbageCollectionScope::new(heap.heap_handle());
-//!   }
-//!   drop(scope);
-//! }
-//! ```
-
-#![allow(clippy::missing_safety_doc)]
-
