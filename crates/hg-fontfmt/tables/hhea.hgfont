# hhea, from OpenType 1.9.1, "hhea - Horizontal Header Table".

table Hhea @ "otspec/hhea" {
  major_version          u16 @ "otspec/hhea#majorVersion"
  minor_version          u16 @ "otspec/hhea#minorVersion"
  ascender               i16 @ "otspec/hhea#ascender"
  descender              i16 @ "otspec/hhea#descender"
  line_gap               i16 @ "otspec/hhea#lineGap"
  advance_width_max      u16 @ "otspec/hhea#advanceWidthMax"
  min_left_side_bearing  i16 @ "otspec/hhea#minLeftSideBearing"
  min_right_side_bearing i16 @ "otspec/hhea#minRightSideBearing"
  x_max_extent           i16 @ "otspec/hhea#xMaxExtent"
  caret_slope_rise       i16 @ "otspec/hhea#caretSlopeRise"
  caret_slope_run        i16 @ "otspec/hhea#caretSlopeRun"
  caret_offset           i16 @ "otspec/hhea#caretOffset"
  reserved0              i16 @ "otspec/hhea#reserved"
  reserved1              i16 @ "otspec/hhea#reserved"
  reserved2              i16 @ "otspec/hhea#reserved"
  reserved3              i16 @ "otspec/hhea#reserved"
  metric_data_format     i16 @ "otspec/hhea#metricDataFormat"
  number_of_h_metrics    u16 @ "otspec/hhea#numberOfHMetrics"
}
