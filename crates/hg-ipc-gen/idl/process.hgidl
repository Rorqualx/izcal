/// Process bootstrap (M1): the first endpoint every child process holds,
/// to the browser process. A renderer starts with exactly this endpoint
/// and receives every other one from the broker (Stage 1 design 4.1).
protocol process;

/// Why a bootstrap request failed. Closed: no free text crosses a
/// process boundary (coding standard CS-ER-6).
error ProcessError {
    /// This build does not support the request.
    Unsupported,
    /// The process is shutting down.
    ShuttingDown,
}

/// The process kinds the broker launches at M1 (Stage 1 design M1 exit;
/// networking NW-D3). The browser and the Linux spawner are not children
/// of this protocol. The same list as `hg_launch_plan::Kind`.
enum ProcessKind {
    /// A renderer: one site's web content.
    Renderer,
    /// The network system service.
    NetworkSystem,
    /// A container's network service.
    NetworkContainer,
    /// A (top-level site, container)'s network service.
    NetworkPartition,
}

/// The sandbox a child reached, by OS (security scope 6.7; SEC-8).
enum SandboxTier {
    /// Linux: seccomp and Landlock, no namespaces.
    LinuxNoUserns,
    /// Linux: seccomp, Landlock, user, PID and network namespaces, no
    /// mount namespace (a non-reference configuration).
    LinuxRestrictedUserns,
    /// Linux: the security scope 6.7 row.
    LinuxFull,
    /// macOS: the deny-default SBPL profile.
    MacosSbpl,
    /// Windows: AppContainer, lockdown token and job (the M1 subset).
    WindowsAppContainer,
    /// Under the simulator: no OS sandbox exists.
    Simulated,
}

/// A part of the 6.7 row the child did not reach.
enum SandboxFeature {
    /// No empty root (Linux).
    EmptyRoot,
    /// No user-namespace id map (Linux).
    IdMap,
    /// No mount namespace (Linux).
    MountNamespace,
    /// No Landlock UDP rules (Linux, ABI below 10).
    LandlockUdp,
    /// No alternate desktop (Windows, M5).
    AlternateDesktop,
    /// No win32k lockdown (Windows, M5).
    Win32kLockdown,
    /// No code integrity guard (Windows, M5).
    CodeIntegrityGuard,
}

/// What the child's own probes found after lockdown. A cross-check of
/// what the launcher applied: a mismatch ends the child (design review M3).
struct SandboxReport {
    /// The tier reached.
    tier: SandboxTier,
    /// What the 6.7 row has that this tier lacks; empty for the full row.
    missing: vec<SandboxFeature, 8>,
}

/// What a child is for, sent once after `ready`. Ids are the broker's own
/// opaque numbers; the child does nothing kind-specific before this.
union ChildConfig {
    /// A renderer for one site.
    Renderer {
        /// The broker's id of the site.
        site: u64,
    },
    /// The network system service.
    NetworkSystem,
    /// One container's service.
    NetworkContainer {
        /// The broker's id of the container.
        container: u64,
    },
    /// One (top-level site, container)'s service.
    NetworkPartition {
        /// The broker's id of the top-level site.
        top_site: u64,
        /// The broker's id of the container.
        container: u64,
    },
}

/// Identifies a build; a child from another build is refused.
struct BuildId {
    /// The truncated digest of the build's inputs, compiled into every
    /// binary of the build (`hg_types::BUILD_ID`; distribution 13 item 5).
    id: u64,
}

/// Why the browser tells a child to exit.
union ExitReason {
    /// The browser is shutting down or no longer needs the process.
    Normal,
    /// The child reported another build than the browser's.
    BuildMismatch {
        /// The browser's build.
        expected: BuildId,
    },
    /// The child's request failed.
    Failed {
        /// Why.
        error: ProcessError,
    },
}

/// Child to browser, on the bootstrap endpoint.
interface ProcessHost bound capacity 64 overflow terminate {
    /// The child has started and is ready for work.
    ready(
        /// What the child is.
        kind: ProcessKind,
        /// The child's build.
        build: BuildId,
        /// The sandbox it reached.
        sandbox: SandboxReport,
    );
    /// The answer to `ProcessControl.ping`.
    pong(
        /// The ping's nonce.
        nonce: u64,
    );
    /// M1's skeleton work (Stage 1 M1 exit: an IPC round trip through the
    /// browser): the child asks for something only another child can
    /// answer; the browser routes it and returns `ProcessControl.answered`.
    ask(
        /// The child's own request number.
        id: u64,
        /// What it asks.
        payload: bytes<256>,
    );
    /// The answer to `ProcessControl.work`.
    answer(
        /// The work's number.
        id: u64,
        /// The result.
        payload: bytes<256>,
    );
}

/// Browser to child, on the bootstrap endpoint.
interface ProcessControl bound capacity 64 overflow terminate {
    /// Asks the child to answer with `ProcessHost.pong`.
    ping(
        /// Echoed in the answer.
        nonce: u64,
    );
    /// Tells the child to exit.
    exit(
        /// Why.
        reason: ExitReason,
    );
    /// What the child is for; sent once, after `ready` is accepted.
    start(
        /// The child's configuration.
        config: ChildConfig,
    );
    /// Work the browser routes to this child (M1 skeleton).
    work(
        /// The browser's number for it.
        id: u64,
        /// What to do.
        payload: bytes<256>,
    );
    /// The answer to this child's `ProcessHost.ask`.
    answered(
        /// The ask's number.
        id: u64,
        /// The answer.
        payload: bytes<256>,
    );
}
