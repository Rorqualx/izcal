op Neg(fb: slot<unary>) acc inout after_call result
  effects { alloc_internal, throw(any), call_user }
  anchor ecma262 "sec-unary-minus-operator-runtime-semantics-evaluation"
{
  match acc {
    Smi(a) => path smi speculate fb.smi anchor ecma262 "sec-numeric-types-number-unaryMinus" {
      acc = number(f64.neg(f64(a)));   // -0 is a heap number
      next;
    }
    Num(a) => path number speculate fb.number anchor ecma262 "sec-numeric-types-number-unaryMinus" {
      acc = number(f64.neg(a));
      next;
    }
    _ => path generic {
      acc = rt_unary(UN_NEG, acc);
      next;
    }
  }
}

op BitNot(fb: slot<unary>) acc inout after_call result
  effects { alloc_internal, throw(any), call_user }
  anchor ecma262 "sec-bitwise-not-operator-runtime-semantics-evaluation"
{
  match acc {
    Smi(a) => path smi speculate fb.smi anchor ecma262 "sec-numeric-types-number-bitwiseNOT" {
      acc = smi(~a);
      next;
    }
    Num(a) => path number speculate fb.number anchor ecma262 "sec-numeric-types-number-bitwiseNOT" {
      acc = number(f64(~f64.to_int32(a)));
      next;
    }
    _ => path generic {
      acc = rt_unary(UN_BIT_NOT, acc);
      next;
    }
  }
}

op Inc(fb: slot<unary>) acc inout after_call result
  effects { alloc_internal, throw(any), call_user }
  anchor ecma262 "sec-prefix-increment-operator-runtime-semantics-evaluation"
{
  match acc {
    Smi(a) => path smi speculate fb.smi anchor ecma262 "sec-numeric-types-number-add" {
      acc = number(f64(i64(a) + 1));
      next;
    }
    Num(a) => path number speculate fb.number anchor ecma262 "sec-numeric-types-number-add" {
      acc = number(f64.add(a, 1.0));
      next;
    }
    _ => path generic {
      acc = rt_unary(UN_INC, acc);
      next;
    }
  }
}

op Dec(fb: slot<unary>) acc inout after_call result
  effects { alloc_internal, throw(any), call_user }
  anchor ecma262 "sec-prefix-decrement-operator-runtime-semantics-evaluation"
{
  match acc {
    Smi(a) => path smi speculate fb.smi anchor ecma262 "sec-numeric-types-number-subtract" {
      acc = number(f64(i64(a) - 1));
      next;
    }
    Num(a) => path number speculate fb.number anchor ecma262 "sec-numeric-types-number-subtract" {
      acc = number(f64.sub(a, 1.0));
      next;
    }
    _ => path generic {
      acc = rt_unary(UN_DEC, acc);
      next;
    }
  }
}
