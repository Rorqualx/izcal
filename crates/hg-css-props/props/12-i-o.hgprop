# @bootstrapped once from @webref/css 8.7.9 on 13 November 2026, then
# hand-maintained. Properties i to o.
#
# The `initial`, `inherited`, `computed`, `animation`, `syntax` and
# `longhands` lines restate what the pinned @webref/css carries, and
# hg-cssgen fails the build when they and webref disagree. That is what
# they are for: the engine is written against these values, and a
# specification change that moved one would otherwise be silent. A
# disagreement is triaged line by line; this file is never regenerated
# from webref to make one go away (ST-7).
#
# `affects` and `hook` are Izcal's own and have no counterpart in
# webref. `affects unknown` records a decision not yet made rather than
# guessing it, and hg-cssgen reports how many remain.

property image-animation @ "https://drafts.csswg.org/css-image-animation-1/#propdef-image-animation" {
  initial   "normal"
  inherited "yes"
  inherits  yes
  computed  "as specified"
  animation "discrete"
  syntax    "normal | paused | stopped | running"
  affects   unknown
}

