#!/usr/bin/env bash
# Izcal pre-push: protects main and re-runs the deterministic checks on
# the pushed commits (catches --no-verify commits). See CONTRIBUTING.md.
set -u
HOOKS_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
. "$HOOKS_DIR/lib.sh"
remote=$1
zero=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && {
    case "$remote_ref" in refs/heads/*) is_protected "${remote_ref#refs/heads/}" && { echo "pre-push: refusing to delete ${remote_ref#refs/heads/}" >&2; status=1; } ;; esac
    continue
  }
  case "$remote_ref" in
    refs/heads/*)
      b=${remote_ref#refs/heads/}
      if is_protected "$b" && [ "${IZCAL_ALLOW_PROTECTED:-}" != 1 ]; then
        echo "pre-push: '$b' is protected; push a feature branch and open a pull request" >&2
        status=1; continue
      fi
      if [ "$remote_sha" != "$zero" ] && is_protected "$b" &&
         ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "pre-push: non-fast-forward push to protected '$b' refused" >&2
        status=1; continue
      fi
      ;;
    # Release tags v* are protected server-side (signed, bypass recorded;
    # SEC-27), so the hook adds no client-side tag rule.
    *) continue ;;
  esac

  # Commits being pushed: from the remote tip, or from the default branch for
  # a new branch.
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" "$(default_remote_branch "$remote")" 2>/dev/null || echo "")
  else
    base=$remote_sha
  fi
  [ -n "$base" ] || { echo "pre-push: no merge base with the default branch; skipping checks" >&2; continue; }

  IZCAL_HOOKS_SKIP="${IZCAL_HOOKS_SKIP:-}" bash "$(checks_script)" --range "$base" "$local_sha" || status=1
done
exit $status
